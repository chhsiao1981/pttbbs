COREOBJS = [
    "bbs.c",
    "announce.c",
    "read.c",
    "board.c",
    "brc.c",
    "mail.c",
    "record.c",
    "fav.c",
]

ABUSEOBJS = [
    "captcha.c",
]

ACCOBJS = [
    "user.c",
    "acl.c",
    "register.c",
    "passwd.c",
    "emaildb.c",
]

NETOBJS = [
    "mbbsd.c",
    "io.c",
    "term.c",
    "telnet.c",
    "nios.c",
]

TALKOBJS = [
    "friend.c",
    "talk.c",
    "ccw.c",
]

UTILOBJS = [
    "stuff.c",
    "kaede.c",
    "convert.c",
    "name.c",
    "syspost.c",
    "cache.c",
    "cal.c",
]

UIOBJS = [
    "menu.c",
    "vtuikit.c",
    "psb.c",
]

PAGEROBJS = [
    "more.c",
    "pmore.c",
]

PLUGOBJS = [
    "ordersong.c",
    "angel.c",
    "timecap.c",
]

CHESSOBJS = [
    "chess.c",
    "chc.c",
    "chc_tab.c",
    "ch_go.c",
    "ch_gomo.c",
    "ch_dark.c",
    "ch_reversi.c",
    "ch_conn6.c",
]

GAMEOBJS = [
    "chicken.c",
    "gamble.c",
]

MISCOBJS = [
    "admin.c",
    "assess.c",
    "edit.c",
    "xyz.c",
    "var.c",
    "vote.c",
    "voteboard.c",
    "comments.c",
]

BBSLUAOBJS = [
    "bbslua.c",
    "bbsluaext.c",
]

SCREENOBJS = [
    "screen.c",
]

MBBSD_CXX_OBJS = [
    "recover.cc",
    "register_sms.cc",
    "verifydb.cc",
    "verifydb_info.cc",
    "verifydb_search.cc",
]

LUACFLAGS = "-I/usr/include/lua5.1"
LUALIBS = "-llua5.1"

PTT_WARN = [
    "-W",
    "-Wall",
    "-Wunused",
    "-Wno-missing-field-initializers",
    "-Wno-address-of-packed-member",
]

cc_library(
    name = "mbbsd",
    srcs = MISCOBJS + COREOBJS + ABUSEOBJS + \
    ACCOBJS + NETOBJS + TALKOBJS + UTILOBJS + \
    UIOBJS + PAGEROBJS + PLUGOBJS + CHESSOBJS + \
    GAMEOBJS + BBSLUAOBJS + SCREENOBJS + ["//mbbsd:versc"],
    visibility = ["//visibility:public"],
    hdrs = [
    ],
    linkstatic = True,
    copts = PTT_WARN + [
        "-pipe",
        "-Iinclude",
        "-Ibazel-out/k8-fastbuild/bin/include",
        "-Ibazel-out/k8-fastbuild/bin/common/fbs",
        LUACFLAGS,
        "-DBBSHOME=$(BBSHOME)",

        # "-Qunused-arguments",
        "-Wno-parentheses-equality",
        # "-fcolor-diagnostics",
        "-Wno-invalid-source-encoding",
    ],
    data = [
    ],
    deps = [
        "//include:all",
        "//:pttbbsconf",
        "//common/fbs:verifydbfbs",
        "//common/fbs:registersmsfbs",
        "//common/osdep:commonosdep",
        "//common/sys:commonsys",
        "//common/bbs:commonbbs",
    ],
)

cc_library(
    name = "mbbsdcxx",
    srcs = MBBSD_CXX_OBJS,
    copts = PTT_WARN + [
        "-pipe",
        "-std=c++17",
        "-Iinclude",
        "-Ibazel-out/k8-fastbuild/bin/include",
        "-Ibazel-out/k8-fastbuild/bin/common/fbs",
        "-DBBSHOME=$(BBSHOME)",

        "-Wno-invalid-source-encoding",
    ],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        "//include:all",
        "//:pttbbsconf",
        "//common/fbs:verifydbfbs",
        "//common/fbs:registersmsfbs",
    ],
)

filegroup(
    name = "varc",
    srcs = glob(["var.c"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "versc",
    srcs = ["vers.c"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "genversc",
    srcs = [],
    outs = ["vers.c"],
    cmd = "echo \"\"; echo \"versc@: $@\"; echo \"pwd: `pwd`\"; mkdir -p mbbsd; cd mbbsd; sh ../$(location //util:newvers); cd ..; cp mbbsd/vers.c $@",
    visibility = ["//visibility:public"],
    tools = [
        "//util:newvers"
    ],
)
